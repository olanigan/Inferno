{
  "name": "@package-inferno/cli",
  "version": "1.0.0",
  "description": "PackageInferno CLI - Shift-left supply chain security for npm packages",
  "author": "PackageInferno Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/MHaggis/Package-Inferno",
  "repository": {
    "type": "git",
    "url": "https://github.com/MHaggis/Package-Inferno.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/MHaggis/Package-Inferno/issues"
  },
  "keywords": [
    "security",
    "supply-chain",
    "npm",
    "malware",
    "scanner",
    "cli",
    "shift-left"
  ],
  "type": "module",
  "bin": {
    "inferno": "./bin/run.js",
    "inferno-cli": "./bin/run.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist oclif.manifest.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "test:coverage": "nyc npm test",
    "version": "oclif readme && git add README.md"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-help": "^6.2.0",
    "@oclif/plugin-plugins": "^5.4.0",
    "dockerode": "^4.0.2",
    "zod": "^3.23.8",
    "js-yaml": "^4.1.0",
    "uuid": "^10.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4.0.0",
    "@types/chai": "^4.3.19",
    "@types/dockerode": "^3.3.31",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.8",
    "@types/node": "^22.7.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "chai": "^5.1.1",
    "eslint": "^9.11.1",
    "eslint-config-oclif": "^5.2.0",
    "eslint-config-oclif-typescript": "^3.1.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.7.3",
    "nyc": "^17.1.0",
    "oclif": "^4.15.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "inferno",
    "dirname": "inferno",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "scan": {
        "description": "Scan packages for malicious code"
      },
      "report": {
        "description": "Generate and export security reports"
      },
      "policy": {
        "description": "Manage security policies"
      },
      "daemon": {
        "description": "Background service for continuous monitoring"
      },
      "config": {
        "description": "Configuration management"
      }
    },
    "hooks": {
      "init": "./dist/hooks/init"
    }
  }
}
